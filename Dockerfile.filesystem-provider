FROM python:3.11-slim

WORKDIR /app
COPY --chown=10001:10001 workshop_sandbox.py filesystem_provider.py ./
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin fsprovider \
    && mkdir -p /workspace/secure-experiment-zone

USER 10001:10001
EXPOSE 8765
CMD ["python", "-u", "filesystem_provider.py"]
