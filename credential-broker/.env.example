PYTHON_PACKAGE_INDEX=https://pypi.org/simple
ENVIRONMENT=development
DATABASE_PATH=/data/leases.db
OPENBAO_ADDR=http://openbao:8200
OPENBAO_MOUNT=runtime-shield
# Populate after manually creating the broker AppRole. Keep secret ID only in ignored .env.
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPA_URL=http://opa:8181/v1/data/runtime_shield/credential/allow
JWT_ISSUER=runtime-shield
JWT_AUDIENCE_AGENT=credential-broker-agent
JWT_AUDIENCE_ADMIN=credential-broker-admin
JWT_AUDIENCE_EGRESS=credential-broker-egress
DEV_AUTH=true
ALLOW_LOCAL_POLICY=true
BROKER_DEV_AGENT_SECRET=
BROKER_DEV_ADMIN_SECRET=
BROKER_DEV_EGRESS_SECRET=
# Set each to a distinct random value of at least 32 characters.
LEASE_MAX_SECONDS=300
LEASE_MAX_USES=1
REGISTERED_MANIFEST_HASHES=sha256:ef6a79401b0d41c9773560c22bfb8d47efb591562b6a2162162c227b748999a7
DELEGATION_MAX_DEPTH=3
