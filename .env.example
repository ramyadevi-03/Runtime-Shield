# Copy this file to .env and fill in the required values locally.
# Never use the blank secret values or commit your populated .env file.

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HTTPS_KEY_STORE_PASSWORD=
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_JWKS_URL=
KEYCLOAK_TOKEN_URL=
RUNTIME_SHIELD_JIT_CLIENT_SECRET=
RUNTIME_SHIELD_LOGIN_CLIENT_ID=admin-cli
RUNTIME_SHIELD_LOGIN_CLIENT_SECRET=

JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
# Use 64 hex characters for CREDS_KEY and 32 hex characters for CREDS_IV.

OPENID_CLIENT_ID=runtime-shield-librechat
OPENID_ISSUER=
OPENID_CLIENT_SECRET=
OPENID_SESSION_SECRET=
RUNTIME_SHIELD_MCP_CLIENT_ID=runtime-shield-hitl
RUNTIME_SHIELD_MCP_CLIENT_SECRET=
RUNTIME_SHIELD_GATEWAY_API_KEY=
# X-API-Key for the dashboard's mutating endpoints (register/sync/delete MCP,
# memory consolidation, events clear). Falls back to
# RUNTIME_SHIELD_GATEWAY_API_KEY when unset.
DASHBOARD_API_KEY=

# start_librechat_demo.ps1 generates this when it is blank.
RUNTIME_SHIELD_FS_PROVIDER_TOKEN=

# Optional model/provider credentials.
NIM_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
HUGGINGFACE_TOKEN=
RUNTIME_SHIELD_DEV_JIT_TOKEN=

HITL_TIMEOUT_SECONDS=180
LOCAL_DEV_MODE=false
